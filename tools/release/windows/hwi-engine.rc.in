// hwi-engine.rc.in - the icon and the VERSIONINFO of hwi-engine.exe (docs/release-windows.md). meson.build fills it in
// for a Windows host and compiles it through meson's windows module, so tools/release_win64.sh and
// tools/release/build-windows.sh both get it. The icon is original art (tools/release/icon/make_icon.py).
// Plain numbers instead of winver.h's names, so the file needs no include path: FILEOS 0x40004 = VOS_NT_WINDOWS32,
// FILETYPE 0x1 = VFT_APP, translation 0x409/1200 = US English, Unicode.

// the first icon group: Explorer, the shortcuts and SDL's window class (ExtractIconEx index 0) all show it
1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
PRODUCTVERSION @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Homeworld-Infection project"
			VALUE "FileDescription", "Homeworld Infection"
			VALUE "FileVersion", "@VERSION@"
			VALUE "InternalName", "hwi-engine"
			VALUE "LegalCopyright", "Based on the Homeworld source code by Relic Entertainment, Relic EULA: non-commercial use only"
			VALUE "OriginalFilename", "hwi-engine.exe"
			VALUE "ProductName", "Homeworld Infection"
			VALUE "ProductVersion", "@VERSION@"
			VALUE "Comments", "build @BUILD_VERSION@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
