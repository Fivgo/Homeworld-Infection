# pins.env - the third-party downloads of the Windows package, each checked by sha256 (tools/release/build-windows.sh,
# docs/release-windows.md). FFmpeg's source pin is FFMPEG_SHA256 in tools/release/ffmpeg-min.sh (shared with the
# Linux and macOS packages). A change here changes the CI cache key (.github/workflows/build-windows.yml).

# llvm-mingw (clang, UCRT), the cross compiler; the sha256 equals GitHub's published digest of the asset
LLVM_MINGW_NAME=llvm-mingw-20261006-ucrt-ubuntu-22.04-x86_64
LLVM_MINGW_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20261006/llvm-mingw-20261006-ucrt-ubuntu-22.04-x86_64.tar.xz
LLVM_MINGW_SHA256=5f9c6ed95b2d4bdb2869a488c5fd5857fbdabcf288a0aa3eb1da43f6a08d8ab4

# SDL2 mingw development tree (headers, import library, SDL2.dll); libsdl publishes no checksum for it
SDL2_VERSION=2.30.12
SDL2_URL=https://github.com/libsdl-org/SDL/releases/download/release-2.30.12/SDL2-devel-2.30.12-mingw.tar.gz
SDL2_SHA256=dddafbf0705a8cbe1f97c69680886ce147ed4d38f1d04e03523681298e081b0f

# innoextract, the official Windows release; the engine runs it to unpack the GOG offline installer
# (docs/release-1.0.md contract 3). 1.9 unpacks setup_homeworld_emergence_1.01_hotfix_(12948).exe (Inno Setup
# data 5.5.7; docs/RUNBOOK.md "innoextract support").
INNOEXTRACT_VERSION=1.9
INNOEXTRACT_URL=https://github.com/dscharrer/innoextract/releases/download/1.9/innoextract-1.9-windows.zip
INNOEXTRACT_SHA256=
